{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "configure",
            "command": "cmake",
            "args": ["--preset", "Debug"],
            "problemMatcher": ["$gcc"]
        },
        {
            "type": "shell",
            "label": "build",
            "command": "uv",
            "args": [
                "run", "--no-project", "Tools/build_summary.py",
                "--cmake-exe", "cmake",
                "--binary-dir", "build/Debug",
                "--target", "firmware",
                "--jobs", "16"
            ],
            "dependsOn": ["configure"],
            "dependsOrder": "sequence",
            "problemMatcher": ["$gcc"],
            "group": {"kind": "build", "isDefault": true}
        },
        {
            "type": "shell",
            "label": "clean",
            "command": "cmake",
            "args": ["--build", "--preset", "Debug", "--target", "clean"],
            "dependsOn": ["configure"],
            "dependsOrder": "sequence",
            "problemMatcher": ["$gcc"],
            "group": "build"
        },
        {
            "label": "rebuild",
            "dependsOn": ["clean", "build"],
            "dependsOrder": "sequence",
            "problemMatcher": [],
            "group": "build"
        },
        {
            "type": "shell",
            "label": "download",
            "command": "cmake",
            "args": ["--build", "--preset", "Debug", "--target", "download"],
            "dependsOn": ["build"],
            "dependsOrder": "sequence",
            "problemMatcher": ["$gcc"],
            "group": "build"
        },
        {
            "label": "rebuild & download",
            "dependsOn": ["rebuild", "download"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        }
    ]
}
